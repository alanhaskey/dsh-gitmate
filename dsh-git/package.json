{
  "name": "@local/dsh-git",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Git control for DeepSeek Harness: a right-sidebar panel plus agent tools for status, staging, commits with generated messages, remotes, and branches.",
  "icon": "./icon.svg",
  "main": "./lib/plugin.js",
  "exports": {
    ".": "./lib/plugin.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
